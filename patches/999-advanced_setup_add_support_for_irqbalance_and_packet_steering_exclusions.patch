 set_smp_affinity()
 {
-	logger -s "smp_affinity: # Setup affinity of each physical irq."
+	log_msg "[smp_affinity] Setting up affinity of each hardware IRQ"
 	num=0
+	irqbalance_enabled=$(uci get irqbalance.@irqbalance[0].enabled 2>/dev/null || echo 0)
+	if [ "$irqbalance_enabled" == 1 ]; then
+		log_msg "[smp_affinity] irqbalance is enabled"
+		irqbalance_excluded_irqs=$(uci get irqbalance.@irqbalance[0].banirq 2>/dev/null)
+		irqbalance_settings_modified=0
+		true > "$IRQBALANCE_IRQS"
+	fi
 	while [ "$num" -lt "$NUM_OF_CPU" ];do
 		eval smp_list=\$CPU${num}_AFFINITY
 		for i in $smp_list; do
 			cpu_bit=$((2 ** $num))
 			virq=$(get_virtual_irq $i)
 			if [ -z "$virq" ]; then
-				logger -t advanced_setup "smp_affinity: active IRQ for hwirq $i not found, skipping"
+				log_msg "[smp_affinity] No virtual IRQ mapped for hardware IRQ $i, skipping"
 				continue
 			fi
 
-			logger -s "smp_affinity: irq p2v $i --> $virq"
+			log_msg "[smp_affinity] Hardware IRQ $i maps to virtual IRQ $virq"
 			if ! echo "$cpu_bit" > "/proc/irq/$virq/smp_affinity"; then
-				logger -t advanced_setup "smp_affinity: failed to set IRQ $virq affinity to CPU$num"
+				log_msg "[smp_affinity] Failed to set affinity of virtual IRQ $virq to CPU$num"
+				continue
 			fi
+
+			case "$irqbalance_enabled: $irqbalance_excluded_irqs " in
+				1:*" $virq "*) log_msg "[smp_affinity] Virtual IRQ $virq is already excluded from irqbalance" ;;
+				1:*)
+					log_msg "[smp_affinity] Adding virtual IRQ $virq to irqbalance exclusions"
+					echo "$virq" >> "$IRQBALANCE_IRQS"
+					irqbalance_settings_modified=1
+					;;
+			esac
 		done
 		num=`expr $num + 1`
 	done
+	if [ -f "$IRQBALANCE_IRQS" ] && [ "$irqbalance_settings_modified" == 1 ]; then
+		log_msg "[smp_affinity] Applying irqbalance changes"
+		if /etc/init.d/irqbalance status > /dev/null 2>&1; then
+			/etc/init.d/irqbalance restart
+		fi
+	fi
 }
 
 

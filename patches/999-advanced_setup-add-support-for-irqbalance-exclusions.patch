+clean_irqbalance_config()
+{
+	if [ -f /tmp/smp_affinity_irqs ]; then
+		while IFS= read -r excluded_irq; do
+			if [ -n "$excluded_irq" ]; then
+				logger -s "smp_affinity: removing $excluded_irq from irqbalance exclusions"
+				uci del_list irqbalance.@irqbalance[0].banirq="$excluded_irq"
+			fi
+		done < /tmp/smp_affinity_irqs
+		logger -s "smp_affinity: applying irqbalance changes"
+		uci commit irqbalance
+		if [ ! -e /tmp/run/procd.shutdown ] && /etc/init.d/irqbalance status >/dev/null 2>&1; then
+			/etc/init.d/irqbalance restart
+		fi
+		rm /tmp/smp_affinity_irqs
+	fi
+}

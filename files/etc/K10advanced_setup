gl_mt6000()
{
	num_of_wifi=$1
	DEFAULT_RPS=0

	#Physical IRQ# setting
	#Ethernet RSS feature enables 4 Rx rings
	eth_irq_rx0=221
	eth_irq_rx1=222
	eth_irq_rx2=223
	eth_irq_rx3=224
	eth_irq_tx=229
	
	
	if [[ "$WED_ENABLE" -eq "1" ]]; then
		wifi1_irq=237
	else
		wifi1_irq=245
	fi

	for vif in $NET_IF_LIST;
	do
		if [[ "$vif" == "wlan"* ]] || [[ "$vif" == "phy"* ]]; then
			WIFI_IF_LIST="$WIFI_IF_LIST $vif"
		fi
	done;
	
	WAN_IF_LIST=""

	for iface in $(uci show network | grep "=interface" | cut -d '.' -f 2 | cut -d '=' -f1 | sort -u); do
		proto=$(uci get network.$iface.proto 2>/dev/null)
		role=$(uci get network.$iface.role 2>/dev/null)

		if [ "$proto" = "dhcp" ] || [ "$proto" = "pppoe" ] || [ "$role" = "wan" ]; then
			device=$(uci get network.$iface.device 2>/dev/null)

			for dev in $device; do
				if echo "$dev" | grep -q '\.'; then
					base_if=$(uci show network | grep "device..*name='$dev'" | cut -d. -f2 | while read devsec; do
						uci get network.$devsec.ifname 2>/dev/null
					done)

					if [ -n "$base_if" ]; then
						WAN_IF_LIST="$WAN_IF_LIST $base_if"
					fi

				elif [ -d "/sys/class/net/$dev" ]; then
					WAN_IF_LIST="$WAN_IF_LIST $dev"

				else
					alias_if=$(uci get network.$dev.ifname 2>/dev/null)
					if [ -n "$alias_if" ]; then
						WAN_IF_LIST="$WAN_IF_LIST $alias_if"
					fi
				fi
			done
		fi
	done

	WAN_IF_LIST=$(echo "$WAN_IF_LIST" | tr ' ' '\n' | sort -u | tr '\n' ' ')
	
	BRIDGE_MEMBERS=""

	if [ -d /sys/class/net/br-lan/brif ]; then
		for member in $(ls /sys/class/net/br-lan/brif); do
			case "$member" in
				wlan*|phy*)
					continue
					;;
			esac

			if echo "$member" | grep -q '\.'; then
				parent="${member%%.*}"
				BRIDGE_MEMBERS="$BRIDGE_MEMBERS $parent"
			else
				BRIDGE_MEMBERS="$BRIDGE_MEMBERS $member"
			fi
		done
	fi

	BRIDGE_MEMBERS=$(echo $BRIDGE_MEMBERS | tr ' ' '\n' | sort -u | tr '\n' ' ')
	
	log_msg "[smp_affinity] WAN_IF_LIST = $WAN_IF_LIST"
	log_msg "[smp_affinity] BRIDGE_LIST = $BRIDGE_MEMBERS"
	log_msg "[smp_affinity] WIFI_IF_LIST = $WIFI_IF_LIST"
	
	# Please update the CPU binding in each cases.
	# CPU#_AFFINITY="add binding irq number here"
	# CPU#_RPS="add binding interface name here"
	
	#we bound all wifi card to cpu1 and bound eth to cpu0
	CPU0_AFFINITY="$eth_irq_rx0"
	CPU1_AFFINITY="$eth_irq_rx1 $eth_irq_tx"
	CPU2_AFFINITY="$eth_irq_rx2 $wifi2_irq $wifi3_irq"
	CPU3_AFFINITY="$eth_irq_rx3 $wifi1_irq"
	
	rps_type=$(uci get advanced.@advanced_packet_steering[0].advanced_packet_steering_enable 2>/dev/null)

	if [ -z "$rps_type" ] || [ "$rps_type" = "1" ]; then
		CPU0_RPS="$WIFI_IF_LIST"
		CPU1_RPS="$WIFI_IF_LIST"
		CPU2_RPS="$WIFI_IF_LIST"
		CPU3_RPS="$WIFI_IF_LIST"
	elif  [ "$rps_type" = "2" ]; then
		CPU0_RPS="$BRIDGE_MEMBERS $WIFI_IF_LIST"
		CPU1_RPS="$WAN_IF_LIST $WIFI_IF_LIST"
		CPU2_RPS="$WAN_IF_LIST $WIFI_IF_LIST"
		CPU3_RPS="$WAN_IF_LIST $WIFI_IF_LIST"
	fi

}


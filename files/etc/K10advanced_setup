get_virtual_irq()
{
	PHY_POS=`expr $NUM_OF_CPU + 3` #physical irq # position in /proc/interrups may vary with the number of CPU up
	target_phy_irq=$1
	cat /proc/interrupts | sed 's/:/ /g'| awk '$1 ~ /^[0-9]+$/' | while read line
	do
		set -- $line
		phy_irq=$(eval "echo \$$PHY_POS")
		if [ $phy_irq == $target_phy_irq ]; then
			echo $1
			return
		fi
	done
}

set_rps_cpu_bitmap()
{
	log_msg "[smp_affinity] Scanning binding interfaces of each CPU"
	# suppose the value of interface_var is null or hex
	num=0
	while [ "$num" -lt "$NUM_OF_CPU" ];do
		cpu_bit=$((2 ** $num))
		eval rps_list=\$CPU${num}_RPS
		log_msg "[smp_affinity] CPU$num: rps_list=$rps_list"
		for i in $rps_list; do
			var=${VAR_PREFIX}_${i//'-'/_}
			var=${var//'.'/_}
			eval ifval=\$$var
			log_msg "[smp_affinity] [var val before] $var=$ifval"
			if [ -z "$ifval" ]; then
				eval $var=$cpu_bit
			else
				eval $var=`expr $ifval + $cpu_bit`
			fi
			eval ifval=\$$var
			log_msg "[smp_affinity] [rps val after]$i=$ifval"
		done
		num=`expr $num + 1`
	done
}

# $1: The default rps value. If rps of the interface is not setup, set $1 to it
set_rps_cpus()
{
	log_msg "[smp_affinity] Setting up RPS on interfaces: $RPS_IF_LIST"
	for i in $RPS_IF_LIST; do
		var=${VAR_PREFIX}_${i//'-'/_}
		var=${var//'.'/_}
		eval cpu_map=\$$var
		if [ -d /sys/class/net/$i ]; then
			if [ -n "$cpu_map" ]; then
				cpu_map=`printf '%x' $cpu_map`
			elif [ -n "$1" ]; then
				cpu_map="$1"
			fi

			if [ -n "$cpu_map" ]; then
				for rxq in /sys/class/net/$i/queues/rx-*; do
					[ -d "$rxq" ] || continue
					log_msg "[smp_affinity] echo $cpu_map > $rxq/rps_cpus"
					echo $cpu_map > "$rxq/rps_cpus"
				done
			fi
		fi
	done
}

set_smp_affinity()
{
	log_msg "[smp_affinity] Setting up affinity of each physical IRQ"
	num=0
	irqbalance_enabled=$(uci get irqbalance.@irqbalance[0].enabled 2>/dev/null || echo 0)
	if [ "$irqbalance_enabled" == 1 ]; then
		log_msg "[smp_affinity] irqbalance is enabled"
		irqbalance_excluded_irqs=$(uci get irqbalance.@irqbalance[0].banirq 2>/dev/null)
		irqbalance_settings_modified=0
	fi
	while [ "$num" -lt "$NUM_OF_CPU" ];do
		eval smp_list=\$CPU${num}_AFFINITY
		for i in $smp_list; do
			cpu_bit=$((2 ** $num))
			virq=$(get_virtual_irq $i)
			#virq=$i
			log_msg "[smp_affinity] IRQ p2v $i --> $virq"
			if [ ! -z $virq ]; then
				#log_msg "[smp_affinity] echo $cpu_bit > /proc/irq/$virq/smp_affinity"
				echo $cpu_bit > /proc/irq/$virq/smp_affinity
				case "$irqbalance_enabled: $irqbalance_excluded_irqs " in
					1:*" $virq "*) log_msg "[smp_affinity] IRQ $virq already excluded from irqbalance" ;;
					1:*)
						log_msg "[smp_affinity] Adding IRQ $virq to irqbalance exclusions"
						echo $virq >> /tmp/smp_affinity_irqs
						irqbalance_settings_modified=1
						;;
				esac
			fi
		done
		num=`expr $num + 1`
	done
	if [ -f /tmp/smp_affinity_irqs ] && [ "$irqbalance_settings_modified" == 1 ]; then
		log_msg "[smp_affinity] Applying irqbalance changes"
		if /etc/init.d/irqbalance status > /dev/null 2>&1; then
			/etc/init.d/irqbalance restart
		fi
	fi
}



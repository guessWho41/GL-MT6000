#!/bin/sh
#
# This file is interpreted as shell script.
# Put your custom mwan3 action here, they will
# be executed with each netifd hotplug interface event
# on interfaces for which mwan3 is enabled.
#
# There are three main environment variables that are passed to this script.
#
# $ACTION
#      <ifup>         Is called by netifd and mwan3track.
#      <ifdown>       Is called by netifd and mwan3track.
#      <connected>    Is only called by mwan3track if tracking was successful.
#      <disconnected> Is only called by mwan3track if tracking has failed.
# $INTERFACE	Name of the interface an action relates to (e.g. "wan" or "wwan").
# $DEVICE	Physical device name of the interface the action relates to (e.g. "eth0" or "wwan0").
#               Note: On an ifdown event, $DEVICE is not available, use $INTERFACE instead.
#
# Further documentation can be found here:
# https://openwrt.org/docs/guide-user/network/wan/multiwan/mwan3#alertsnotifications

# WireGuard routing and DDNS failover

. /lib/functions.sh

is_online() {
	[ -n "$1" ] || return 1
	echo "$MWAN3_STATUS" | jsonfilter -e "@.interfaces.$1.status" | grep -qx online
}

get_table() {
	local device
	device=$(ubus call network.interface."$1" status 2>/dev/null | jsonfilter -e '@.l3_device')
	[ -n "$device" ] || return 1
	ip rule show | awk -v dev="$device" '$0 ~ ("iif " dev " ") {print $NF}'
}

get_wg_interfaces() {
	ubus call network.interface dump 2>/dev/null | jsonfilter -e '@.interface[@.proto="wireguard"].interface'
}

get_wg_networks() {
	local iface device
	iface="$1"
	_wg_net4=""
	_wg_net6=""
	device=$(ubus call network.interface."$iface" status 2>/dev/null | jsonfilter -e '@.l3_device')
	[ -n "$device" ] || return 1
	_wg_net4=$(ip -4 route show dev "$device" scope link 2>/dev/null | awk '$1 ~ /\// {print $1; exit}')
	_wg_net6=$(ip -6 route show dev "$device" 2>/dev/null | awk '$1 ~ /\// && $1 !~ /^fe80/ && /proto kernel/ {print $1; exit}')
}

get_or_assign_fwmark() {
	local iface idx mark mmx_mask
	iface="$1"
	idx="$2"

	mark=$(uci -q get network."$iface".fwmark)
	[ -n "$mark" ] && { echo "$mark"; return 0; }

	mmx_mask=$(uci -q get mwan3.globals.mmx_mask)
	mmx_mask=${mmx_mask:-0x3F00}
	mark=$(printf "0x%x" $(( mmx_mask + 0x100 + idx * 0x100 )))

	uci set network."$iface".fwmark="$mark"
	uci commit network
	/etc/init.d/network reload
	logger -t mwan3-wg "[$iface] Auto-assigned fwmark $mark and reloaded network"
	echo "$mark"
}

wg_del_rule() {
	local mark
	mark="$1"
	while ip rule show | grep -q "fwmark $mark"; do
		ip rule del fwmark "$mark" 2>/dev/null
	done
}

wg_set_rule() {
	local iface mark prio table
	iface="$1"
	mark="$2"
	prio="$3"
	table=$(get_table "$iface")
	[ -n "$table" ] || {
		logger -t mwan3-wg "[$iface] Could not resolve table, aborting"
		return 1
	}
	wg_del_rule "$mark"
	ip rule add fwmark "$mark" lookup "$table" priority "$prio"
	logger -t mwan3-wg "[$iface] WireGuard routing via table $table"
}

ensure_rule_before() {
	local rule anchor sections section pos_rule pos_anchor idx
	rule="$1"
	anchor="$2"
	sections="$3"
	pos_rule=-1
	pos_anchor=-1
	idx=0
	for section in $sections; do
		[ "$section" = "$rule" ] && pos_rule=$idx
		[ "$section" = "$anchor" ] && pos_anchor=$idx
		idx=$((idx + 1))
	done
	[ "$pos_rule" -ge 0 ] && [ "$pos_anchor" -ge 0 ] && [ "$pos_rule" -lt "$pos_anchor" ] && return 0
	[ "$pos_anchor" -ge 0 ] && uci reorder mwan3."$rule"="$pos_anchor"
}

get_default_rule_info() {
	local sections section pos_v4 pos_v6 idx
	sections="$1"
	_first_default=""
	pos_v4=-1
	pos_v6=-1
	idx=0
	for section in $sections; do
		[ "$section" = "default_rule_v4" ] && pos_v4=$idx
		[ "$section" = "default_rule_v6" ] && pos_v6=$idx
		idx=$((idx + 1))
	done
	if [ "$pos_v4" -ge 0 ] && [ "$pos_v6" -ge 0 ]; then
		[ "$pos_v4" -lt "$pos_v6" ] && _first_default="default_rule_v4" || _first_default="default_rule_v6"
	elif [ "$pos_v4" -ge 0 ]; then
		_first_default="default_rule_v4"
	elif [ "$pos_v6" -ge 0 ]; then
		_first_default="default_rule_v6"
	fi
}

ensure_wg_mwan3_rules() {
	local wg_iface sections rule_v4 rule_v6 current_src current_policy changed
	wg_iface="$1"
	sections="$2"
	changed=""

	get_wg_networks "$wg_iface" || {
		logger -t mwan3-wg "[$wg_iface] Could not resolve networks, skipping mwan3 rules"
		return 1
	}

	[ -n "$_first_default" ] || {
		logger -t mwan3-wg "[$wg_iface] No default mwan3 rules found, skipping"
		return 1
	}

	rule_v4="vpn_${wg_iface}_v4"
	rule_v6="vpn_${wg_iface}_v6"

	if [ -n "$_wg_net6" ] && [ -n "$POLICY_V6" ]; then
		current_src=$(uci -q get mwan3."$rule_v6".src_ip)
		current_policy=$(uci -q get mwan3."$rule_v6".use_policy)
		if [ "$current_src" != "$_wg_net6" ] || [ "$current_policy" != "$POLICY_V6" ]; then
			uci set mwan3."$rule_v6"=rule
			uci set mwan3."$rule_v6".family='ipv6'
			uci set mwan3."$rule_v6".proto='all'
			uci set mwan3."$rule_v6".src_ip="$_wg_net6"
			uci set mwan3."$rule_v6".sticky='0'
			uci set mwan3."$rule_v6".use_policy="$POLICY_V6"
			ensure_rule_before "$rule_v6" "$_first_default" "$sections"
			logger -t mwan3-wg "[$wg_iface] Updated mwan3 v6 rule: src=$_wg_net6 policy=$POLICY_V6"
			changed=1
		fi
	fi

	if [ -n "$_wg_net4" ] && [ -n "$POLICY_V4" ]; then
		current_src=$(uci -q get mwan3."$rule_v4".src_ip)
		current_policy=$(uci -q get mwan3."$rule_v4".use_policy)
		if [ "$current_src" != "$_wg_net4" ] || [ "$current_policy" != "$POLICY_V4" ]; then
			uci set mwan3."$rule_v4"=rule
			uci set mwan3."$rule_v4".family='ipv4'
			uci set mwan3."$rule_v4".proto='all'
			uci set mwan3."$rule_v4".src_ip="$_wg_net4"
			uci set mwan3."$rule_v4".sticky='0'
			uci set mwan3."$rule_v4".use_policy="$POLICY_V4"
			ensure_rule_before "$rule_v4" "$_first_default" "$sections"
			logger -t mwan3-wg "[$wg_iface] Updated mwan3 v4 rule: src=$_wg_net4 policy=$POLICY_V4"
			changed=1
		fi
	fi

	[ -n "$changed" ]
}

_ddns_handle_section() {
	local section enabled use_ipv6 current ip_source
	section="$1"
	config_get enabled "$section" enabled
	[ "$enabled" = "1" ] || return
	config_get use_ipv6 "$section" use_ipv6
	if [ "$_ddns_family" = "ipv6" ]; then
		[ "$use_ipv6" = "1" ] || return
	else
		[ "$use_ipv6" = "1" ] && return
	fi
	config_get current "$section" interface
	[ "$current" != "$_ddns_target" ] || return
	logger -t mwan3-ddns "[${_ddns_family}] Switching '$section' from $current to $_ddns_target"
	uci set ddns."$section".interface="$_ddns_target"
	config_get ip_source "$section" ip_source
	case "$ip_source" in
		network)   uci set ddns."$section".ip_network="$_ddns_target" ;;
		web)       uci set ddns."$section".bind_network="$_ddns_target" ;;
		interface) uci set ddns."$section".ip_interface="$_ddns_target" ;;
		*)         logger -t mwan3-ddns "[${_ddns_family}] Unknown ip_source for '$section', skipping network binding" ;;
	esac
	_ddns_modified=1
}

update_ddns() {
	local primary backup family
	primary="$1"
	backup="$2"
	family="$3"

	_ddns_target=""
	if is_online "$primary"; then
		_ddns_target="$primary"
	elif is_online "$backup"; then
		_ddns_target="$backup"
	fi
	[ -n "$_ddns_target" ] || return

	_ddns_family="$family"
	_ddns_modified=""
	config_foreach _ddns_handle_section service

	[ -n "$_ddns_modified" ] || return
	logger -t mwan3-ddns "[$family] Applying DDNS changes"
	uci commit ddns
	/etc/init.d/ddns restart
}

update_wg() {
	local iface mark prio primary backup
	iface="$1"
	mark="$2"
	prio="$3"
	primary="$4"
	backup="$5"

	[ -n "$mark" ] || {
		logger -t mwan3-wg "[$iface] No fwmark configured, skipping"
		return
	}
	[ -n "$prio" ] || {
		logger -t mwan3-wg "[$iface] Could not determine priority, skipping"
		return
	}

	if is_online "$primary"; then
		wg_set_rule "$primary" "$mark" "$prio"
	elif is_online "$backup"; then
		wg_set_rule "$backup" "$mark" "$prio"
	else
		wg_del_rule "$mark"
		logger -t mwan3-wg "[$iface] All WANs down, removing ip rule"
	fi
}

case "$ACTION" in
	connected|disconnected)

		MWAN3_STATUS=$(ubus call mwan3 status 2>/dev/null)

		POLICY_V4=$(uci -q get mwan3.default_rule_v4.use_policy)
		[ -n "$POLICY_V4" ] && {
			V4=$(echo "$MWAN3_STATUS" | jsonfilter -e "@.policies.ipv4.${POLICY_V4}[0].interface" -e "@.policies.ipv4.${POLICY_V4}[1].interface" 2>/dev/null)
			PRIMARY_V4=$(echo "$V4" | sed -n '1p')
			BACKUP_V4=$(echo "$V4" | sed -n '2p')
		}

		POLICY_V6=$(uci -q get mwan3.default_rule_v6.use_policy)
		[ -n "$POLICY_V6" ] && {
			V6=$(echo "$MWAN3_STATUS" | jsonfilter -e "@.policies.ipv6.${POLICY_V6}[0].interface" -e "@.policies.ipv6.${POLICY_V6}[1].interface" 2>/dev/null)
			PRIMARY_V6=$(echo "$V6" | sed -n '1p')
			BACKUP_V6=$(echo "$V6" | sed -n '2p')
		}

		if [ -f /etc/config/ddns ] && /etc/init.d/ddns enabled 2>/dev/null; then
			config_load ddns
			update_ddns "$PRIMARY_V4" "$BACKUP_V4" ipv4
			[ -n "$PRIMARY_V6" ] && update_ddns "$PRIMARY_V6" "$BACKUP_V6" ipv6
		fi

		WG_IFACES=$(get_wg_interfaces)
		if [ -n "$WG_IFACES" ]; then
			WG_PRIO=$(ip rule show | awk '/iif/ {gsub(/:/, "", $1); n=$1+0; if (min=="" || n<min) min=n} END {print min}')
			WG_PRIO=$((WG_PRIO - 1))

			MWAN3_SECTIONS=$(uci show mwan3 | awk -F'[.=]' '/^mwan3\.[^.]+=[^.]+$/ {print $2}')
			get_default_rule_info "$MWAN3_SECTIONS"

			MWAN3_RULES_CHANGED=""
			IDX=0
			for WG_IFACE in $WG_IFACES; do
				WG_MARK=$(get_or_assign_fwmark "$WG_IFACE" "$IDX")
				IDX=$((IDX + 1))
				[ -n "$WG_MARK" ] || {
					logger -t mwan3-wg "[$WG_IFACE] Skipping: could not get or assign fwmark"
					continue
				}
				update_wg "$WG_IFACE" "$WG_MARK" "$WG_PRIO" "$PRIMARY_V4" "$BACKUP_V4"
				ensure_wg_mwan3_rules "$WG_IFACE" "$MWAN3_SECTIONS" && MWAN3_RULES_CHANGED=1
			done

			if [ -n "$MWAN3_RULES_CHANGED" ]; then
				uci commit mwan3
				/etc/init.d/mwan3 reload
			fi
		fi

		;;
esac

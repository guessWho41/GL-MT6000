#!/bin/sh
#
# This file is interpreted as shell script.
# Put your custom mwan3 action here, they will
# be executed with each netifd hotplug interface event
# on interfaces for which mwan3 is enabled.
#
# There are three main environment variables that are passed to this script.
#
# $ACTION
#      <ifup>         Is called by netifd and mwan3track.
#      <ifdown>       Is called by netifd and mwan3track.
#      <connected>    Is only called by mwan3track if tracking was successful.
#      <disconnected> Is only called by mwan3track if tracking has failed.
# $INTERFACE	Name of the interface an action relates to (e.g. "wan" or "wwan").
# $DEVICE	Physical device name of the interface the action relates to (e.g. "eth0" or "wwan0").
#               Note: On an ifdown event, $DEVICE is not available, use $INTERFACE instead.
#
# Further documentation can be found here:
# https://openwrt.org/docs/guide-user/network/wan/multiwan/mwan3#alertsnotifications

# DDNS failover

. /lib/functions.sh

is_online() {
	[ -n "$1" ] || return 1
	echo "$MWAN3_STATUS" | jsonfilter -e "@.interfaces.$1.status" | grep -qx online
}

resolve_target() {
	local family rule policy members primary backup
	family="$1"
	rule="$2"

	policy=$(uci -q get mwan3."$rule".use_policy)
	[ -n "$policy" ] || return

	members=$(echo "$MWAN3_STATUS" | jsonfilter -e "@.policies.${family}.${policy}[0].interface" -e "@.policies.${family}.${policy}[1].interface" 2>/dev/null)
	primary=$(echo "$members" | sed -n '1p')
	backup=$(echo "$members" | sed -n '2p')

	[ -n "$primary" ] || {
		logger -t mwan3-ddns "[$family] Policy $policy not found in mwan3 status"
		return
	}

	if is_online "$primary"; then
		echo "$primary"
	elif is_online "$backup"; then
		echo "$backup"
	fi
}

_ddns_handle_section() {
	local section enabled use_ipv6 family target current ip_source
	section="$1"

	config_get enabled "$section" enabled
	[ "$enabled" = "1" ] || return

	config_get use_ipv6 "$section" use_ipv6
	if [ "$use_ipv6" = "1" ]; then
		family="ipv6"
		target="$_TARGET_V6"
	else
		family="ipv4"
		target="$_TARGET_V4"
	fi
	[ -n "$target" ] || return

	config_get current "$section" interface
	[ "$current" != "$target" ] || return

	logger -t mwan3-ddns "[$family] Switching '$section' from $current to $target"
	uci set ddns."$section".interface="$target"
	config_get ip_source "$section" ip_source
	case "$ip_source" in
		network)   uci set ddns."$section".ip_network="$target" ;;
		web)       uci set ddns."$section".bind_network="$target" ;;
		interface) uci set ddns."$section".ip_interface="$target" ;;
		*)         logger -t mwan3-ddns "[$family] Unknown ip_source for '$section', skipping network binding" ;;
	esac
	_DDNS_MODIFIED=1
}

case "$ACTION" in
	connected|disconnected)

		[ -f /etc/config/ddns ] || exit 0
		/etc/init.d/ddns enabled 2>/dev/null || exit 0

		MWAN3_STATUS=$(ubus call mwan3 status 2>/dev/null)

		_TARGET_V4=$(resolve_target ipv4 default_rule_v4)
		_TARGET_V6=$(resolve_target ipv6 default_rule_v6)
		[ -n "$_TARGET_V4$_TARGET_V6" ] || exit 0

		_DDNS_MODIFIED=""
		config_load ddns
		config_foreach _ddns_handle_section service

		[ -n "$_DDNS_MODIFIED" ] || exit 0
		logger -t mwan3-ddns "Applying DDNS changes"
		uci commit ddns
		/etc/init.d/ddns restart

		;;
esac
